# ---------------------------------------------------------------------------------------------------
# Movie Recommender — environment configuration
#
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds your private API key.
# ---------------------------------------------------------------------------------------------------

# TMDB API key (REQUIRED).
#
# Get one free at https://www.themoviedb.org/settings/api — create an account, request an API key,
# and copy the value labelled "API Key (v3 auth)". It should be a 32-character hex string.
#
# This is the v3 API key, NOT the longer "API Read Access Token" (v4). The server passes it as an
# `api_key` query parameter, which only works with the v3 key.
#
# Without this the server still boots and serves the frontend, but every /api route returns
# HTTP 400 with `{"error": "API key not set in .env file"}`.
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Port the Express server listens on (OPTIONAL).
#
# Defaults to 3001 if unset. Note that the frontend hardcodes `http://localhost:3001/api` as its API
# base URL when running on localhost, so changing this in development also requires updating
# API_URL in public/index.html.
# PORT=3001


# ---------------------------------------------------------------------------------------------------
# Cache configuration (OPTIONAL) — see lib/cache.js
# ---------------------------------------------------------------------------------------------------

# Directory for the disk-backed cache.
#
# UNSET (the default) selects the in-memory cache. That is what production uses: Render's filesystem
# is ephemeral, so cache files there would not survive a restart or deploy anyway.
#
# SET it to persist the cache to disk. Do this for local development and for the offline corpus build
# and evaluation harness, which cannot re-issue thousands of TMDB requests on every run.
#
# The directory is created if missing. Add it to .gitignore — it can grow large.
# CACHE_DIR=.cache

# Maximum entries held by the in-memory cache before least-recently-used eviction (OPTIONAL).
#
# Defaults to 1000. A TMDB movie-details payload is roughly 10-25 KB parsed, so the default occupies
# on the order of 10-25 MB — well inside Render's 512 MB free-instance limit. Raise it only if you
# have headroom to spare. Ignored when CACHE_DIR is set.
# CACHE_MAX_ENTRIES=1000
